# ============================================================
# JOB OUTREACH SYSTEM — ENVIRONMENT
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.

# ---------- Shared AI / search providers ----------
# Used by app/integrations/openai_client.py and app/integrations/web_search.py,
# which the Job Outreach module calls into directly (email discovery,
# email generation, job search).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
API_AUTH_TOKEN=
LOG_LEVEL=INFO

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# Job Outreach module (personal job-application system)
# ============================================================
# See backend/app/job_outreach/ and docs/job-outreach-schema.md.
# Own Google Sheet, own service account, own sender identity, own Apps
# Script project (apps-script-job-outreach/).

JOB_OUTREACH_SHEET_ID=
JOB_OUTREACH_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key with literal \n newlines preserved (quoted).
JOB_OUTREACH_SERVICE_ACCOUNT_PRIVATE_KEY=

# Personal Gmail sender identity — Apps Script triggers for this module
# must be authorized under this exact Google account (GmailApp always sends
# as whichever account installed the triggers, regardless of this value).
JOB_OUTREACH_SENDER_EMAIL=prabhatkumarsictc12@gmail.com

# Resume PDF, read by Apps Script via DriveApp.getFileById(...).getBlob()
# and attached to every outgoing application email. Drive file id from
# https://drive.google.com/file/d/<id>/view.
JOB_OUTREACH_RESUME_DRIVE_FILE_ID=1CijF9kbtlaTuay4iVsguC12Dnkc9lCc-

# Candidate identity used in generated email bodies — public resume info,
# not secrets, real defaults are intentional here.
JOB_OUTREACH_CANDIDATE_NAME=Prabhat Kumar Singh
JOB_OUTREACH_CANDIDATE_PHONE=+91 9801675811
JOB_OUTREACH_CANDIDATE_LINKEDIN=https://www.linkedin.com/in/prabhat-singh-3a4ab3303/
JOB_OUTREACH_CANDIDATE_GITHUB=https://github.com/Prabhat9801

# Shared daily cap across every (role, city) search cycle, no carryover.
JOB_OUTREACH_DAILY_EMAIL_CAP=100

# Safety — defaults true. While true, every outgoing application email is
# redirected to JOB_OUTREACH_TEST_EMAIL.
JOB_OUTREACH_EMAIL_TEST_MODE=true
JOB_OUTREACH_TEST_EMAIL=
