# ============================================================
# BOTIVATE AI JOB INTELLIGENCE + OUTREACH SYSTEM — ENVIRONMENT
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Tavily Search (Web Search / job discovery) ----------
# Get a key at https://tavily.com — used to discover job postings via
# site-scoped and general queries (see docs/search.md).
TAVILY_API_KEY=

# ---------- DEPRECATED: Google Custom Search ----------
# No longer used (replaced by Tavily above after persistent 403s and a low
# 100-queries/day free cap). Left here only so old deployments don't break;
# safe to leave blank or remove entirely.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---------- Google Sheets (primary database) ----------
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key with literal \n newlines preserved (quoted).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------- Botivate sender identity (Apps Script sends via this Gmail/Workspace account) ----------
BOTIVATE_SENDER_EMAIL=
BOTIVATE_SENDER_NAME=Satyendra Kumar Tandan

BOTIVATE_WEBSITE_URL=https://botivate.in
AUTOROCKET_WEBSITE_URL=https://autorocket.botivate.in

# ---------- Google Apps Script Web App (backend -> Apps Script trigger, optional) ----------
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_SHARED_SECRET=

# ---------- Safety ----------
EMAIL_TEST_MODE=true
TEST_EMAIL=

MOCK_MODE=false

# ---------- Queue / follow-up limits ----------
# NOTE: actual send pacing is controlled by Apps Script's OWN
# QUEUE_BATCH_SIZE Script Property (see apps-script/Config.gs), not this
# value — this backend never sends email itself. Kept in sync at 1 for
# clarity only.
QUEUE_BATCH_SIZE=1
QUEUE_MAX_ATTEMPTS=3
MAX_FOLLOW_UPS=4

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
API_AUTH_TOKEN=
LOG_LEVEL=INFO

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
